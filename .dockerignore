# Contexto único na raiz: somente entradas utilizadas pelos três builds.
**
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!pom.xml
!contratos-grpc/
!contratos-grpc/pom.xml
!contratos-grpc/src/
!contratos-grpc/src/**
!pedido-service/
!pedido-service/pom.xml
!pedido-service/src/
!pedido-service/src/**
!api-gateway/
!api-gateway/pom.xml
!api-gateway/src/
!api-gateway/src/**
!estoque-service/
!estoque-service/pyproject.toml
!estoque-service/requirements*.txt
!estoque-service/gerar-proto.sh
!estoque-service/src/
!estoque-service/src/**
!web/
!web/**

# Mesmo dentro das pastas permitidas, nunca enviar arquivos locais ou segredos.
**/target
**/.venv
**/__pycache__
**/*.pyc
**/*.egg-info
**/.env*
**/*.env
**/*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.log
**/*.mv.db
**/*.trace.db
estoque-service/src/estoque/generated/*_pb2.py
estoque-service/src/estoque/generated/*_pb2_grpc.py
