# Ambiente local padrão (H2 iniciado por scripts/h2.sh).
DB_PROFILE=local
DB_CONNECT_TIMEOUT=5
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=estoque_demo
DB_USER=sa
DB_PASSWORD=sa
GRPC_HOST=127.0.0.1
GRPC_PORT=9091
GRPC_WORKERS=4

# Para nuvem: DB_PROFILE=cloud, DB_HOST/DB_NAME/DB_USER/DB_PASSWORD do PostgreSQL.
# DB_PORT=5432 e DB_SSLMODE=require (ou verify-full com certificados configurados).
